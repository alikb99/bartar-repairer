RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.bartar-repairer\.com$ [NC]
RewriteRule ^ https://bartar-repairer.com%{REQUEST_URI} [R=301,L]
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/(.+)\.aso\.bak$ /logo.png [R=301,L]

# Android app package: serve with the correct MIME type so browsers download it
# instead of mis-handling it, and force a download rather than inline handling.
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment"
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Compress text responses (HTML/CSS/JS/JSON/SVG). With a ~1.2s TTFB on this
# host, smaller transfers are the main lever we control for FCP/LCP.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/ld+json font/ttf
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Favicons: cacheable but re-checkable so a replaced icon propagates.
  <FilesMatch "\.(?:ico)$|^(?:icon-\d+|apple-icon)\.png$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # HTML: a short browser TTL so a repeat view inside one session is instant,
  # while `must-revalidate` still forces a conditional request afterwards. The
  # ArvanCloud edge caches these independently of this value.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  # The repair-request handler must never be cached.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Security headers. ArvanCloud's panel has no field for these, so they are set
# at the origin and pass through the edge. `always` is required — without it
# Apache skips the header on redirects and error responses.
<IfModule mod_headers.c>
  # HSTS: every request already 301s to HTTPS, so the only thing left to remove
  # is that first insecure hop. No includeSubDomains — subdomains of this
  # domain are not all on HTTPS, and the directive would break them. No preload
  # either: getting off the preload list takes months.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Stop browsers from guessing a MIME type different from what we send. The
  # .apk download and the JSON-LD blocks both depend on their declared type.
  Header always set X-Content-Type-Options "nosniff"

  # Send the full URL to our own pages, only the origin to third parties. Keeps
  # referrer analytics working for the balad map and outbound brand links
  # without leaking Persian query strings to them.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Clickjacking. frame-ancestors is the modern form; X-Frame-Options stays for
  # older browsers that ignore CSP.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Deliberately minimal CSP. A full policy would have to enumerate the inline
  # JSON-LD blocks, Next's inline bootstrap and the Google PSE / balad.ir
  # iframes — one mistake there blanks the site. These two directives cannot
  # break a page that already works: they only forbid being framed elsewhere
  # and upgrade any stray http:// subresource.
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"

  # Browser features this site never uses. Denying them removes the permission
  # prompts entirely rather than relying on the user to decline.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

