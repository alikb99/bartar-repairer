# The DB slug said A57 while the page's title and body are about the A56 and
# no other A56 LCD page exists. Slug corrected in lib/content.ts PATH_RENAMES;
# this keeps the 877 impressions the old URL earned.
RedirectMatch 301 ^/a57-lcd-replacement/?$ /a56-lcd-replacement/

# Found in the GSC coverage export (these carry no impressions, so the
# impressions-based sweep above never saw them).
RedirectMatch 301 ^/service/?$ /services/
RedirectMatch 301 ^/samsung-washing-machine/?$ /samsung/samsung-washing-machine/
RedirectMatch 301 ^/iphone-6-repair-2/?$ /iphone-6repair/
RedirectMatch 301 ^/تعمیر-لپ-تاپ-سونی/?$ /sony/lap-top/

# WordPress date archives (/2024/11/09/, /2022/01/, /2021/) and the old Persian
# article index. None of these have an equivalent in the static site.
RedirectMatch 301 ^/(19|20)[0-9]{2}(/[0-9]{2}){0,2}/?$ /blog/
RedirectMatch 301 ^/مقالات/?$ /blog/
RedirectMatch 301 ^/comprehensive-tutorial-on-using-a-laptop-as-a-monitor/?$ /blog/

# Malformed inbound links: a trailing ")" or Persian comma got glued onto the
# URL inside old post content, so Google crawled the punctuation as part of the
# path. Strip it and serve the real page.
RedirectMatch 301 "^(/.+?)/[)،]/?$" $1/
RedirectMatch 301 ^(/.+?)/(feed|embed)/?$ $1/
