# Archive and feed URLs that no longer exist in the static site. The optional
# (/feed) group is what keeps /tag/x/feed/ from taking two hops: without it the
# generic feed rule below would send it to /tag/x/, which then redirects again.
RedirectMatch 301 ^/author/[^/]+(/page/[0-9]+)?(/feed)?/?$ /blog/
RedirectMatch 301 ^/tag/[^/]+(/page/[0-9]+)?(/feed)?/?$ /blog/
RedirectMatch 301 ^/category/[^/]+(/page/[0-9]+)?(/feed)?/?$ /blog/
RedirectMatch 301 ^/blog/page/(2[4-9]|[3-9][0-9]|[0-9]{3,})/?$ /blog/
RedirectMatch 301 ^/wp-admin(/.*)?$ /

